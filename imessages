#!/usr/bin/env ruby
# frozen_string_literal: true

#
# imessages - CLI for reading and sending iMessages
#
# Usage:
#   imessages threads  [--limit 20] [--since DATE]
#   imessages thread   <contact> [--limit 50] [--since DATE]
#   imessages search   <query> [--limit 20] [--from CONTACT]
#   imessages send     <contact> <message>
#   imessages chats    [--limit 20]
#   imessages chat     <chat_id> [--limit 50]
#   imessages contacts <query>
#   imessages aliases
#
# Contact can be a phone number (+1234567890), an alias from aliases.yml,
# or a name to search in Contacts.app.
#
# All read operations query ~/Library/Messages/chat.db directly.
# Send uses AppleScript via osascript.
#
# Output: single-line JSON to stdout

require 'bundler/setup'
require 'json'
require 'sqlite3'
require 'optparse'
require 'yaml'
require 'open3'
require 'time'

DB_PATH = File.expand_path("~/Library/Messages/chat.db")
ALIASES_PATH = File.join(__dir__, "aliases.yml")

# Apple CoreData nanosecond timestamp epoch (2001-01-01 00:00:00 UTC)
APPLE_EPOCH_OFFSET = 978307200
NANOSECOND_FACTOR = 1_000_000_000

# --------------------------------------------------------------------------
# Output helpers
# --------------------------------------------------------------------------

def output(data)
  puts JSON.generate(data)
end

def success(data)
  output(ok: true, data: data)
  exit 0
end

def error(msg, code = 'ERROR', details = nil)
  output(ok: false, error: msg, code: code, details: details)
  exit 1
end

# --------------------------------------------------------------------------
# Date helpers
# --------------------------------------------------------------------------

def apple_to_time(apple_ns)
  return nil if apple_ns.nil? || apple_ns == 0
  unix = (apple_ns.to_f / NANOSECOND_FACTOR) + APPLE_EPOCH_OFFSET
  Time.at(unix).localtime
end

def apple_to_iso(apple_ns)
  t = apple_to_time(apple_ns)
  t&.iso8601
end

def date_to_apple_ns(date_str)
  t = Time.parse(date_str)
  ((t.to_f - APPLE_EPOCH_OFFSET) * NANOSECOND_FACTOR).to_i
end

# --------------------------------------------------------------------------
# attributedBody fallback
# --------------------------------------------------------------------------

def extract_attributed_body_text(blob)
  return nil if blob.nil? || blob.empty?
  # NSAttributedString binary blob: extract readable text
  # Use binary encoding to safely scan, then extract ASCII/UTF-8 text
  bytes = blob.dup.force_encoding('BINARY')
  return nil unless bytes.include?('NSString'.encode('BINARY'))
  
  # Find text after NSString marker: the pattern is NSString + type byte + length prefix + text
  # The text appears between NSString header bytes and NSDictionary
  markers = %w[streamtyped NSAttributedString NSObject NSString NSDictionary NSNumber NSValue __kIMMessagePartAttributeName]
  
  # Extract readable ASCII segments (4+ chars between non-printable bytes)
  segments = bytes.scan(/[\x20-\x7e]{4,}/)
  segments = segments.map { |s| s.force_encoding('UTF-8') }
  segments = segments.reject { |s| markers.include?(s) }
  
  # The actual message text is typically the longest segment, or we can join non-marker segments
  # But we need to handle multi-part messages (rich text with inline objects)
  # Strategy: take segments that appear after "NSString" in the blob
  ns_string_pos = bytes.index('NSString'.encode('BINARY'))
  return nil unless ns_string_pos
  
  after = bytes[ns_string_pos..]
  text_segments = after.scan(/[\x20-\x7e]{2,}/)
  text_segments = text_segments.map { |s| s.force_encoding('UTF-8') }
  text_segments = text_segments.reject { |s| markers.include?(s) || s.start_with?('+') && s.length <= 3 }
  
  # The first text segment has a "+<length_byte>" prefix from NSArchiver encoding - strip it
  if text_segments.first && text_segments.first.start_with?('+')
    text_segments[0] = text_segments.first[2..]
  end
  
  # "iI" is a trailing NSArchiver marker
  text_segments = text_segments.reject { |s| s == 'iI' || s == 'iM' }
  
  result = text_segments.join('')
  return result.empty? ? nil : result
rescue
  nil
end

def message_text(row)
  row['text'] || extract_attributed_body_text(row['attributedBody'])
end

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

def open_db
  error("Messages database not found at #{DB_PATH}", 'NOT_FOUND') unless File.exist?(DB_PATH)
  SQLite3::Database.new(DB_PATH, results_as_hash: true, readonly: true)
end

# --------------------------------------------------------------------------
# Contact / alias resolution
# --------------------------------------------------------------------------

def load_aliases
  return {} unless File.exist?(ALIASES_PATH)
  data = YAML.load_file(ALIASES_PATH) || {}
  # Normalize keys to lowercase
  data.transform_keys(&:downcase)
rescue => e
  {}
end

def search_contacts_app(query)
  script = <<~APPLESCRIPT
    tell application "Contacts"
      set output to ""
      set matchedPeople to (every person whose name contains "#{query.gsub('"', '\\"')}")
      repeat with p in matchedPeople
        set pName to name of p
        set pPhones to {}
        repeat with ph in (every phone of p)
          set end of pPhones to (label of ph) & ":" & (value of ph)
        end repeat
        set pEmails to {}
        repeat with em in (every email of p)
          set end of pEmails to (label of em) & ":" & (value of em)
        end repeat
        set phoneStr to ""
        repeat with i from 1 to count of pPhones
          if i > 1 then set phoneStr to phoneStr & ";"
          set phoneStr to phoneStr & (item i of pPhones)
        end repeat
        set emailStr to ""
        repeat with i from 1 to count of pEmails
          if i > 1 then set emailStr to emailStr & ";"
          set emailStr to emailStr & (item i of pEmails)
        end repeat
        set output to output & pName & "\\t" & phoneStr & "\\t" & emailStr & "\\n"
      end repeat
      return output
    end tell
  APPLESCRIPT

  stdout, stderr, status = Open3.capture3('osascript', '-e', script)
  unless status.success?
    error("Contacts.app search failed: #{stderr.strip}", 'CONTACTS_ERROR')
  end

  results = []
  stdout.strip.split("\n").each do |line|
    next if line.strip.empty?
    parts = line.split("\t", -1)
    name = parts[0]&.strip
    phones = (parts[1] || "").split(";").map do |p|
      label, value = p.split(":", 2)
      { label: label&.strip, value: value&.strip }
    end.reject { |p| p[:value].nil? || p[:value].empty? }
    emails = (parts[2] || "").split(";").map do |e|
      label, value = e.split(":", 2)
      { label: label&.strip, value: value&.strip }
    end.reject { |e| e[:value].nil? || e[:value].empty? }
    results << { name: name, phones: phones, emails: emails }
  end
  results
end

def looks_like_phone?(str)
  str.match?(/\A\+?\d[\d\s\-()]{6,}\z/)
end

def normalize_phone(str)
  digits = str.gsub(/[^\d+]/, '')
  digits = "+1#{digits}" if digits.length == 10 && !digits.start_with?('+')
  digits = "+#{digits}" unless digits.start_with?('+')
  digits
end

# Resolve a contact string to a phone number.
# Returns { phone: "+1...", name: "...", source: "direct|alias|contacts" }
# or raises an error with disambiguation options.
def resolve_contact(input)
  return { phone: normalize_phone(input), name: nil, source: 'direct' } if looks_like_phone?(input)

  # Check aliases
  aliases = load_aliases
  key = input.downcase.strip
  if aliases[key]
    entry = aliases[key]
    if entry.is_a?(Hash)
      return { phone: normalize_phone(entry['phone']), name: entry['name'] || key, source: 'alias' }
    else
      return { phone: normalize_phone(entry.to_s), name: key, source: 'alias' }
    end
  end

  # Search Contacts.app
  results = search_contacts_app(input)
  if results.empty?
    error("No contact found for '#{input}'. Add an alias in aliases.yml or use a phone number.", 'NOT_FOUND')
  elsif results.length == 1
    contact = results.first
    phone = contact[:phones].first
    error("Contact '#{contact[:name]}' has no phone number.", 'NO_PHONE') unless phone
    return { phone: normalize_phone(phone[:value]), name: contact[:name], source: 'contacts' }
  else
    # Multiple matches — return them for disambiguation
    error(
      "Multiple contacts match '#{input}'. Be more specific or add an alias.",
      'AMBIGUOUS',
      results.map { |c| { name: c[:name], phones: c[:phones].map { |p| p[:value] } } }
    )
  end
end

# --------------------------------------------------------------------------
# Handle name resolution (from Messages DB handle IDs to display names)
# --------------------------------------------------------------------------

def build_handle_map(db)
  handles = {}
  db.execute("SELECT ROWID, id, service FROM handle").each do |row|
    handles[row['ROWID']] = { id: row['id'], service: row['service'] }
  end
  handles
end

# Build a normalized phone→name map from the AddressBook SQLite databases.
# This is much faster and more reliable than AppleScript lookups, which fail
# due to phone number formatting mismatches (e.g., "+1 555-123-4567" vs "+15551234567").
def build_contacts_phone_map
  return @contacts_phone_map if @contacts_phone_map

  @contacts_phone_map = {}
  ab_dir = File.expand_path("~/Library/Application Support/AddressBook")

  # Collect all AddressBook database paths (main + sources)
  db_paths = Dir.glob(File.join(ab_dir, "**", "AddressBook-v22.abcddb"))

  db_paths.each do |db_path|
    begin
      ab_db = SQLite3::Database.new(db_path, results_as_hash: true, readonly: true)
      rows = ab_db.execute(<<~SQL)
        SELECT
          COALESCE(r.ZFIRSTNAME, '') || ' ' || COALESCE(r.ZLASTNAME, '') as full_name,
          p.ZFULLNUMBER as phone
        FROM ZABCDRECORD r
        JOIN ZABCDPHONENUMBER p ON p.ZOWNER = r.Z_PK
        WHERE p.ZFULLNUMBER IS NOT NULL
          AND (r.ZFIRSTNAME IS NOT NULL OR r.ZLASTNAME IS NOT NULL)
      SQL
      rows.each do |row|
        name = row['full_name']&.strip
        next if name.nil? || name.empty?
        normalized = normalize_phone(row['phone'])
        # First entry wins (don't overwrite)
        @contacts_phone_map[normalized] ||= name
      end
      ab_db.close
    rescue => e
      # Skip unreadable databases
    end
  end

  @contacts_phone_map
end

# Build a normalized email→name map from the AddressBook SQLite databases.
def build_contacts_email_map
  return @contacts_email_map if @contacts_email_map

  @contacts_email_map = {}
  ab_dir = File.expand_path("~/Library/Application Support/AddressBook")
  db_paths = Dir.glob(File.join(ab_dir, "**", "AddressBook-v22.abcddb"))

  db_paths.each do |db_path|
    begin
      ab_db = SQLite3::Database.new(db_path, results_as_hash: true, readonly: true)
      # Check if email table exists
      tables = ab_db.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='ZABCDEMAILADDRESS'")
      next if tables.empty?
      rows = ab_db.execute(<<~SQL)
        SELECT
          COALESCE(r.ZFIRSTNAME, '') || ' ' || COALESCE(r.ZLASTNAME, '') as full_name,
          e.ZADDRESS as email
        FROM ZABCDRECORD r
        JOIN ZABCDEMAILADDRESS e ON e.ZOWNER = r.Z_PK
        WHERE e.ZADDRESS IS NOT NULL
          AND (r.ZFIRSTNAME IS NOT NULL OR r.ZLASTNAME IS NOT NULL)
      SQL
      rows.each do |row|
        name = row['full_name']&.strip
        next if name.nil? || name.empty?
        email = row['email']&.strip&.downcase
        next if email.nil? || email.empty?
        @contacts_email_map[email] ||= name
      end
      ab_db.close
    rescue => e
      # Skip unreadable databases
    end
  end

  @contacts_email_map
end

def resolve_handle_name(handle_id_str)
  return nil if handle_id_str.nil? || handle_id_str.empty?

  @handle_name_cache ||= {}
  return @handle_name_cache[handle_id_str] if @handle_name_cache.key?(handle_id_str)

  name = nil
  if looks_like_phone?(handle_id_str)
    phone_map = build_contacts_phone_map
    normalized = normalize_phone(handle_id_str)
    name = phone_map[normalized]
  else
    # Likely an email handle
    email_map = build_contacts_email_map
    name = email_map[handle_id_str.downcase]
  end

  @handle_name_cache[handle_id_str] = name
  name
end

# Batch resolve names for a set of handle IDs.
# Pre-populates the cache, then returns { handle_id_string => "Contact Name" or nil }
def batch_resolve_names(handle_ids)
  @handle_name_cache ||= {}
  to_resolve = handle_ids.uniq.reject { |id| @handle_name_cache.key?(id) }

  # Pre-load contact maps once, then resolve all at once
  unless to_resolve.empty?
    has_phones = to_resolve.any? { |id| looks_like_phone?(id) }
    has_emails = to_resolve.any? { |id| !looks_like_phone?(id) }
    build_contacts_phone_map if has_phones
    build_contacts_email_map if has_emails

    to_resolve.each { |hid| resolve_handle_name(hid) }
  end

  handle_ids.each_with_object({}) do |hid, map|
    map[hid] = @handle_name_cache[hid]
  end
end

def display_name_for_handle(handle_id_str)
  name = resolve_handle_name(handle_id_str)
  name || handle_id_str
end

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

def cmd_threads(options)
  db = open_db
  limit = options[:limit] || 20
  since_clause = ""
  params = []

  if options[:since]
    since_ns = date_to_apple_ns(options[:since])
    since_clause = "AND m.date >= ?"
    params << since_ns
  end

  # Get most recent message per chat (1:1 chats only, style=45)
  rows = db.execute(<<~SQL, params)
    SELECT
      c.ROWID as chat_id,
      c.chat_identifier,
      c.display_name,
      c.service_name,
      c.style,
      h.id as handle_id,
      MAX(m.date) as last_date,
      COUNT(m.ROWID) as message_count
    FROM chat c
    JOIN chat_message_join cmj ON cmj.chat_id = c.ROWID
    JOIN message m ON m.ROWID = cmj.message_id #{since_clause}
    LEFT JOIN chat_handle_join chj ON chj.chat_id = c.ROWID
    LEFT JOIN handle h ON h.ROWID = chj.handle_id
    WHERE c.style = 45
    GROUP BY c.ROWID
    ORDER BY last_date DESC
    LIMIT #{limit.to_i}
  SQL

  # Collect handle IDs for batch resolution
  handle_ids = rows.map { |r| r['handle_id'] }.compact.uniq
  batch_resolve_names(handle_ids)

  # Get last message text for each chat
  threads = rows.map do |row|
    last_msg = db.execute(<<~SQL, [row['chat_id']]).first
      SELECT m.text, m.attributedBody, m.is_from_me, m.date
      FROM message m
      JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
      WHERE cmj.chat_id = ?
      ORDER BY m.date DESC
      LIMIT 1
    SQL

    {
      chat_id: row['chat_id'],
      handle: row['handle_id'] || row['chat_identifier'],
      contact_name: row['handle_id'] ? resolve_handle_name(row['handle_id']) : nil,
      display_name: row['display_name']&.empty? ? nil : row['display_name'],
      service: row['service_name'],
      message_count: row['message_count'],
      last_message_date: apple_to_iso(row['last_date']),
      last_message: last_msg ? {
        text: message_text(last_msg),
        is_from_me: last_msg['is_from_me'] == 1,
        date: apple_to_iso(last_msg['date'])
      } : nil
    }
  end

  success(threads: threads, count: threads.length)
end

def cmd_thread(contact_input, options)
  resolved = resolve_contact(contact_input)
  phone = resolved[:phone]
  db = open_db
  limit = options[:limit] || 50
  since_clause = ""
  params = []

  if options[:since]
    since_ns = date_to_apple_ns(options[:since])
    since_clause = "AND m.date >= ?"
    params << since_ns
  end

  # Find handle(s) matching this phone
  phone_variants = [phone, phone.sub(/^\+1/, ''), phone.sub(/^\+/, '')]
  placeholders = phone_variants.map { '?' }.join(', ')

  handle_rows = db.execute(
    "SELECT ROWID, id, service FROM handle WHERE id IN (#{placeholders})",
    phone_variants
  )

  if handle_rows.empty?
    error("No message history found for #{phone}", 'NOT_FOUND')
  end

  handle_ids = handle_rows.map { |r| r['ROWID'] }
  handle_placeholders = handle_ids.map { '?' }.join(', ')

  rows = db.execute(<<~SQL, handle_ids + params)
    SELECT
      m.ROWID,
      m.guid,
      m.text,
      m.attributedBody,
      m.is_from_me,
      m.date,
      m.date_read,
      m.date_delivered,
      m.service,
      m.cache_has_attachments,
      m.associated_message_type,
      m.thread_originator_guid,
      h.id as handle_id
    FROM message m
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    WHERE m.handle_id IN (#{handle_placeholders}) #{since_clause}
    ORDER BY m.date DESC
    LIMIT #{limit.to_i}
  SQL

  messages = rows.reverse.map do |row|
    msg = {
      id: row['ROWID'],
      guid: row['guid'],
      text: message_text(row),
      is_from_me: row['is_from_me'] == 1,
      date: apple_to_iso(row['date']),
      service: row['service'],
    }
    msg[:has_attachments] = true if row['cache_has_attachments'] == 1

    # Include attachment details
    if row['cache_has_attachments'] == 1
      attachments = db.execute(<<~SQL, [row['ROWID']])
        SELECT a.filename, a.mime_type, a.transfer_name, a.total_bytes
        FROM attachment a
        JOIN message_attachment_join maj ON maj.attachment_id = a.ROWID
        WHERE maj.message_id = ?
      SQL
      unless attachments.empty?
        msg[:attachments] = attachments.map do |a|
          {
            filename: a['transfer_name'] || a['filename'],
            mime_type: a['mime_type'],
            bytes: a['total_bytes']
          }
        end
      end
    end

    msg
  end

  success(
    contact: {
      phone: phone,
      name: resolved[:name],
      source: resolved[:source]
    },
    messages: messages,
    count: messages.length
  )
end

def cmd_search(query, options)
  db = open_db
  limit = options[:limit] || 20
  conditions = ["(m.text LIKE ? OR m.attributedBody LIKE ?)"]
  params = ["%#{query}%", "%#{query}%"]

  if options[:from]
    resolved = resolve_contact(options[:from])
    phone = resolved[:phone]
    phone_variants = [phone, phone.sub(/^\+1/, ''), phone.sub(/^\+/, '')]
    placeholders = phone_variants.map { '?' }.join(', ')
    conditions << "h.id IN (#{placeholders})"
    params.concat(phone_variants)
  end

  where = conditions.join(" AND ")

  rows = db.execute(<<~SQL, params)
    SELECT
      m.ROWID,
      m.text,
      m.attributedBody,
      m.is_from_me,
      m.date,
      m.service,
      h.id as handle_id,
      c.chat_identifier,
      c.display_name as chat_name,
      c.style
    FROM message m
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    LEFT JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
    LEFT JOIN chat c ON c.ROWID = cmj.chat_id
    WHERE #{where}
    ORDER BY m.date DESC
    LIMIT #{limit.to_i}
  SQL

  # Batch resolve names
  handle_ids = rows.map { |r| r['handle_id'] }.compact.uniq
  batch_resolve_names(handle_ids)

  messages = rows.map do |row|
    {
      id: row['ROWID'],
      text: message_text(row),
      is_from_me: row['is_from_me'] == 1,
      date: apple_to_iso(row['date']),
      service: row['service'],
      handle: row['handle_id'],
      contact_name: row['handle_id'] ? @handle_name_cache[row['handle_id']] : nil,
      chat: row['chat_identifier'],
      chat_name: row['chat_name']&.empty? ? nil : row['chat_name'],
      is_group: row['style'] == 43
    }
  end

  success(messages: messages, count: messages.length, query: query)
end

def send_via_applescript(phone, text: nil, files: [], sms: false)
  escaped_phone = phone.gsub('"', '\\"')

  send_lines = []
  if text && !text.strip.empty?
    escaped_message = text.gsub('\\', '\\\\\\\\').gsub('"', '\\"')
    send_lines << %Q{send "#{escaped_message}" to targetBuddy}
  end
  files.each do |f|
    escaped_path = f.gsub('\\', '\\\\\\\\').gsub('"', '\\"')
    send_lines << %Q{send POSIX file "#{escaped_path}" to targetBuddy}
  end

  unless sms
    script = <<~APPLESCRIPT
      tell application "Messages"
        set targetService to 1st account whose service type = iMessage
        set targetBuddy to participant "#{escaped_phone}" of targetService
        #{send_lines.join("\n      ")}
      end tell
    APPLESCRIPT

    stdout, stderr, status = Open3.capture3('osascript', '-e', script)
    return true if status.success?
  end

  # Try SMS service (as fallback, or directly if --sms flag)
  sms_script = <<~APPLESCRIPT
    tell application "Messages"
      set targetService to 1st account whose service type = SMS
      set targetBuddy to participant "#{escaped_phone}" of targetService
      #{send_lines.join("\n      ")}
    end tell
  APPLESCRIPT

  stdout2, stderr2, status2 = Open3.capture3('osascript', '-e', sms_script)
  unless status2.success?
    imessage_err = sms ? "" : "#{(stderr || '').strip} / "
    error("Failed to send message: #{imessage_err}#{(stderr2 || '').strip}", 'SEND_FAILED')
  end
  true
end

def cmd_send(contact_input, message_text, options = {})
  files = options[:files] || []

  # Validate: need at least text or a file
  has_text = message_text && !message_text.strip.empty?
  error("Message text or --file is required", 'USAGE') if !has_text && files.empty?

  # Validate files exist
  files.each do |f|
    error("File not found: #{f}", 'FILE_NOT_FOUND') unless File.exist?(f)
    error("File not readable: #{f}", 'FILE_NOT_READABLE') unless File.readable?(f)
  end

  resolved = resolve_contact(contact_input)
  phone = resolved[:phone]

  send_via_applescript(phone, text: has_text ? message_text : nil, files: files, sms: options[:sms])

  result = {
    sent: true,
    to: {
      phone: phone,
      name: resolved[:name],
      source: resolved[:source]
    },
  }
  result[:message] = message_text if has_text
  result[:attachments] = files.map { |f| File.basename(f) } unless files.empty?

  success(result)
end

def cmd_send_group(chat_id, message_text, options = {})
  files = options[:files] || []
  has_text = message_text && !message_text.strip.empty?
  error("Message text or --file is required", 'USAGE') if !has_text && files.empty?

  # Validate files exist
  files.each do |f|
    error("File not found: #{f}", 'FILE_NOT_FOUND') unless File.exist?(f)
    error("File not readable: #{f}", 'FILE_NOT_READABLE') unless File.readable?(f)
  end

  db = open_db
  chat = db.execute("SELECT ROWID, chat_identifier, display_name, service_name FROM chat WHERE ROWID = ?", [chat_id.to_i]).first
  error("Chat #{chat_id} not found", 'NOT_FOUND') unless chat

  chat_identifier = chat['chat_identifier'].gsub('"', '\\"')
  service = chat['service_name'] || 'iMessage'

  send_lines = []
  if has_text
    escaped_message = message_text.gsub('\\', '\\\\\\\\').gsub('"', '\\"')
    send_lines << %Q{send "#{escaped_message}" to targetChat}
  end
  files.each do |f|
    escaped_path = f.gsub('\\', '\\\\\\\\').gsub('"', '\\"')
    send_lines << %Q{send POSIX file "#{escaped_path}" to targetChat}
  end

  script = <<~APPLESCRIPT
    tell application "Messages"
      set targetChat to chat id "#{service};+;#{chat_identifier}"
      #{send_lines.join("\n      ")}
    end tell
  APPLESCRIPT

  stdout, stderr, status = Open3.capture3('osascript', '-e', script)

  # If that didn't work, try finding the chat by iterating
  unless status.success?
    chat_guid = chat['chat_identifier']
    script2 = <<~APPLESCRIPT
      tell application "Messages"
        repeat with aChat in every chat
          if id of aChat contains "#{chat_guid.gsub('"', '\\"')}" then
            #{send_lines.map { |l| l.gsub('targetChat', 'aChat') }.join("\n            ")}
            return "sent"
          end if
        end repeat
        return "not_found"
      end tell
    APPLESCRIPT

    stdout2, stderr2, status2 = Open3.capture3('osascript', '-e', script2)
    if !status2.success? || stdout2.strip == "not_found"
      error("Failed to send to group chat #{chat_id}: #{stderr.strip}", 'SEND_FAILED')
    end
  end

  result = {
    sent: true,
    chat_id: chat_id.to_i,
    chat_name: chat['display_name']&.empty? ? nil : chat['display_name'],
  }
  result[:message] = message_text if has_text
  result[:attachments] = files.map { |f| File.basename(f) } unless files.empty?

  success(result)
end

def cmd_chats(options)
  db = open_db
  limit = options[:limit] || 20

  rows = db.execute(<<~SQL, [limit.to_i])
    SELECT
      c.ROWID as chat_id,
      c.chat_identifier,
      c.display_name,
      c.service_name,
      c.style,
      MAX(cmj.message_date) as last_date,
      COUNT(cmj.message_id) as message_count
    FROM chat c
    JOIN chat_message_join cmj ON cmj.chat_id = c.ROWID
    GROUP BY c.ROWID
    ORDER BY last_date DESC
    LIMIT ?
  SQL

  chats = rows.map do |row|
    chat = {
      chat_id: row['chat_id'],
      identifier: row['chat_identifier'],
      display_name: row['display_name']&.empty? ? nil : row['display_name'],
      service: row['service_name'],
      is_group: row['style'] == 43,
      message_count: row['message_count'],
      last_message_date: apple_to_iso(row['last_date'])
    }

    # Get participants
    participants = db.execute(<<~SQL, [row['chat_id']])
      SELECT h.id, h.service
      FROM handle h
      JOIN chat_handle_join chj ON chj.handle_id = h.ROWID
      WHERE chj.chat_id = ?
    SQL

    chat[:participants] = participants.map { |p| p['id'] }
    chat
  end

  success(chats: chats, count: chats.length)
end

def cmd_chat(chat_id, options)
  db = open_db
  limit = options[:limit] || 50
  since_clause = ""
  params = [chat_id.to_i]

  if options[:since]
    since_ns = date_to_apple_ns(options[:since])
    since_clause = "AND m.date >= ?"
    params << since_ns
  end

  chat = db.execute("SELECT ROWID, chat_identifier, display_name, service_name, style FROM chat WHERE ROWID = ?", [chat_id.to_i]).first
  error("Chat #{chat_id} not found", 'NOT_FOUND') unless chat

  # Get participants
  participants = db.execute(<<~SQL, [chat_id.to_i])
    SELECT h.id, h.service
    FROM handle h
    JOIN chat_handle_join chj ON chj.handle_id = h.ROWID
    WHERE chj.chat_id = ?
  SQL

  # Batch resolve participant names
  participant_ids = participants.map { |p| p['id'] }
  batch_resolve_names(participant_ids)

  rows = db.execute(<<~SQL, params)
    SELECT
      m.ROWID,
      m.guid,
      m.text,
      m.attributedBody,
      m.is_from_me,
      m.date,
      m.service,
      m.cache_has_attachments,
      h.id as handle_id
    FROM message m
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    JOIN chat_message_join cmj ON cmj.message_id = m.ROWID
    WHERE cmj.chat_id = ? #{since_clause}
    ORDER BY m.date DESC
    LIMIT #{limit.to_i}
  SQL

  messages = rows.reverse.map do |row|
    msg = {
      id: row['ROWID'],
      text: message_text(row),
      is_from_me: row['is_from_me'] == 1,
      date: apple_to_iso(row['date']),
      service: row['service'],
      handle: row['handle_id'],
      sender_name: row['is_from_me'] == 1 ? 'me' : (@handle_name_cache[row['handle_id']] || row['handle_id'])
    }
    msg[:has_attachments] = true if row['cache_has_attachments'] == 1
    msg
  end

  success(
    chat: {
      chat_id: chat_id.to_i,
      identifier: chat['chat_identifier'],
      display_name: chat['display_name']&.empty? ? nil : chat['display_name'],
      service: chat['service_name'],
      is_group: chat['style'] == 43,
      participants: participants.map do |p|
        { handle: p['id'], name: @handle_name_cache[p['id']] }
      end
    },
    messages: messages,
    count: messages.length
  )
end

def cmd_contacts(query)
  error("Search query is required", 'USAGE') if query.nil? || query.strip.empty?
  results = search_contacts_app(query)
  success(contacts: results, count: results.length, query: query)
end

def cmd_aliases
  aliases = load_aliases
  if aliases.empty?
    success(aliases: {}, count: 0, path: ALIASES_PATH, exists: File.exist?(ALIASES_PATH))
  else
    formatted = aliases.map do |key, value|
      if value.is_a?(Hash)
        { alias: key, phone: value['phone'], name: value['name'] }
      else
        { alias: key, phone: value.to_s, name: nil }
      end
    end
    success(aliases: formatted, count: formatted.length, path: ALIASES_PATH)
  end
end

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

begin
  command = ARGV.shift
  options = {}

  # Check for --help in ARGV before parsing (so subcommands handle it instead of treating it as an argument)
  show_subcmd_help = ARGV.include?('--help') || ARGV.include?('-h')

  case command
  when 'threads'
    if show_subcmd_help
      puts "Usage: imessages threads [--limit N] [--since DATE]"
      puts "  List 1:1 conversation threads sorted by recency"
      puts "  --limit N      Max threads to return (default: 20)"
      puts "  --since DATE   Only include threads with messages after DATE"
      exit 0
    end
    OptionParser.new do |opts|
      opts.on('--limit N', Integer) { |v| options[:limit] = v }
      opts.on('--since DATE') { |v| options[:since] = v }
    end.parse!
    cmd_threads(options)

  when 'thread'
    if show_subcmd_help
      puts "Usage: imessages thread <contact> [--limit N] [--since DATE]"
      puts "  Show message history with a contact"
      puts "  --limit N      Max messages to return (default: 50)"
      puts "  --since DATE   Only include messages after DATE"
      exit 0
    end
    contact = ARGV.shift
    error("Contact is required. Usage: imessages thread <contact> [--limit N]", 'USAGE') unless contact
    OptionParser.new do |opts|
      opts.on('--limit N', Integer) { |v| options[:limit] = v }
      opts.on('--since DATE') { |v| options[:since] = v }
    end.parse!
    cmd_thread(contact, options)

  when 'search'
    if show_subcmd_help
      puts "Usage: imessages search <query> [--limit N] [--from CONTACT]"
      puts "  Full-text search across messages"
      puts "  --limit N        Max results to return (default: 20)"
      puts "  --from CONTACT   Filter by sender contact"
      exit 0
    end
    query = ARGV.shift
    error("Search query is required. Usage: imessages search <query> [--limit N] [--from CONTACT]", 'USAGE') unless query
    OptionParser.new do |opts|
      opts.on('--limit N', Integer) { |v| options[:limit] = v }
      opts.on('--from CONTACT') { |v| options[:from] = v }
    end.parse!
    cmd_search(query, options)

  when 'send'
    if show_subcmd_help
      puts "Usage: imessages send <contact> [message] [--file PATH] [--sms] [--stdin]"
      puts "  Send a message to a contact"
      puts "  --file PATH    Attach a file (can be repeated)"
      puts "  --sms          Send as SMS/RCS instead of iMessage"
      puts "  --stdin        Read message text from stdin"
      exit 0
    end
    contact = ARGV.shift
    error("Usage: imessages send <contact> [message] [--file PATH] [--sms] [--stdin]", 'USAGE') unless contact
    options[:files] = []
    options[:stdin] = false
    OptionParser.new do |opts|
      opts.on('--file PATH', '--attachment PATH') { |v| options[:files] << v }
      opts.on('--sms', 'Send as SMS/RCS instead of iMessage') { options[:sms] = true }
      opts.on('--stdin', 'Read message text from stdin') { options[:stdin] = true }
    end.parse!
    if options[:stdin]
      message = $stdin.read
    else
      message = ARGV.shift
    end
    error("Usage: imessages send <contact> <message> or --file PATH or --stdin", 'USAGE') if (message.nil? || message.strip.empty?) && options[:files].empty?
    cmd_send(contact, message, options)

  when 'send-group'
    if show_subcmd_help
      puts "Usage: imessages send-group <chat_id> [message] [--file PATH]"
      puts "  Send a message to a group chat"
      puts "  --file PATH    Attach a file (can be repeated)"
      exit 0
    end
    chat_id = ARGV.shift
    error("Usage: imessages send-group <chat_id> [message] [--file PATH]", 'USAGE') unless chat_id
    options[:files] = []
    OptionParser.new do |opts|
      opts.on('--file PATH', '--attachment PATH') { |v| options[:files] << v }
    end.parse!
    message = ARGV.shift
    error("Usage: imessages send-group <chat_id> <message> or --file PATH", 'USAGE') if (message.nil? || message.strip.empty?) && options[:files].empty?
    cmd_send_group(chat_id, message, options)

  when 'chats'
    if show_subcmd_help
      puts "Usage: imessages chats [--limit N]"
      puts "  List all chats (DMs + groups) sorted by recency"
      puts "  --limit N      Max chats to return (default: 20)"
      exit 0
    end
    OptionParser.new do |opts|
      opts.on('--limit N', Integer) { |v| options[:limit] = v }
    end.parse!
    cmd_chats(options)

  when 'chat'
    if show_subcmd_help
      puts "Usage: imessages chat <chat_id> [--limit N] [--since DATE]"
      puts "  Show messages in a specific chat"
      puts "  --limit N      Max messages to return (default: 50)"
      puts "  --since DATE   Only include messages after DATE"
      exit 0
    end
    chat_id = ARGV.shift
    error("Chat ID is required. Usage: imessages chat <chat_id> [--limit N]", 'USAGE') unless chat_id
    OptionParser.new do |opts|
      opts.on('--limit N', Integer) { |v| options[:limit] = v }
      opts.on('--since DATE') { |v| options[:since] = v }
    end.parse!
    cmd_chat(chat_id, options)

  when 'contacts'
    if show_subcmd_help
      puts "Usage: imessages contacts <query>"
      puts "  Search Contacts.app by name"
      exit 0
    end
    query = ARGV.shift
    error("Search query is required. Usage: imessages contacts <query>", 'USAGE') unless query
    cmd_contacts(query)

  when 'aliases'
    if show_subcmd_help
      puts "Usage: imessages aliases"
      puts "  Show configured aliases from aliases.yml"
      exit 0
    end
    cmd_aliases

  when '-h', '--help', 'help', nil
    puts <<~HELP
      imessages - CLI for reading and sending iMessages

      Usage:
        imessages threads  [--limit 20] [--since DATE]      List conversation threads
        imessages thread   <contact> [--limit 50]           Messages with a contact
        imessages search   <query> [--limit 20] [--from C]  Search messages
        imessages send     <contact> [message] [--file P] [--stdin]  Send message/file (1:1)
        imessages send-group <chat_id> [msg] [--file P]     Send message/file to group
        imessages chats    [--limit 20]                     List all chats (DMs + groups)
        imessages chat     <chat_id> [--limit 50]           Messages in a chat
        imessages contacts <query>                          Search Contacts.app
        imessages aliases                                   Show configured aliases

      Contact can be:
        - Phone number: +15551234567
        - Alias from aliases.yml: mom, dad
        - Name to search in Contacts.app: "Jane Doe"

      Output: JSON to stdout
    HELP
    exit 0

  else
    error("Unknown command: #{command}", 'USAGE',
          'Commands: threads, thread, search, send, send-group, chats, chat, contacts, aliases')
  end

rescue => e
  error(e.message, 'ERROR', e.backtrace&.first(3)&.join("\n"))
end
